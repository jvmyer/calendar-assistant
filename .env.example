# Kopie nach .env und ausfüllen (.env nie committen)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAUMZEIT_ICS_URL=
# optional: Datenverzeichnis (Standard: ./data)
# PLANNER_DATA_DIR=

# MCP-Server (gibt Claude Werkzeuge auf den echten Planer-Stand, siehe deploy/README.md §11)
# Zufälliges Token erzeugen z. B. mit: openssl rand -hex 32
MCP_TOKEN=
# Standard 127.0.0.1 (nur per SSH-Tunnel erreichbar). Für direkten Zugriff übers Tailnet:
# MCP_HOST=<tailscale-ip>
# MCP_PORT=8765
